# gemini = Gemini, then Ollama, then none. ollama = Ollama, then none. none = no LLM.
LLM_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=
OLLAMA_MODEL=qwen3:4b
# Serve LLM responses only from the disk cache.
DEMO_MODE=false
# Dev only. Loads unverified records and shows a banner.
SHOW_UNVERIFIED=false

# Frontend. Only VITE_-prefixed values reach the browser.
VITE_API_BASE_URL=http://localhost:8000
VITE_USE_FIXTURES=false
